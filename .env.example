# Optional cloud sync. Leave both unset to build without it (the Sync card then says it is not set up).
# Project Settings → API in the Supabase dashboard. The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
